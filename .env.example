# ── Pace Restaurant AI WhatsApp Order Bot Environment Config (Template) ──
# ⚠️ NEVER commit real API keys to Git. Copy this file to .env and fill in values.

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Gateway (WAHA)
WAHA_API_URL=http://your-waha-host:32768
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=Pace
WAHA_WEBHOOK_SECRET=your-random-webhook-secret-string
WAHA_ENABLED=true

# Supabase (Service Role Key server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-SERVICE-ROLE-key
SUPABASE_TABLE=pace_orders
SUPABASE_MENU_TABLE=MenuPace

# Redis
REDIS_URL=redis://localhost:6379/0

# Access Control
ALLOWED_NUMBERS_ONLY=false
ALLOWED_NUMBERS=923306874242,923379221111

# Restaurant Configuration
RESTAURANT_NAME=Pace Restaurant
